generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceHeartbeat {
  id        String   @id @default(cuid())
  service   String   @unique
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("service_heartbeat")
}
